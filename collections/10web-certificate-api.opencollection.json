                "value": "API_KEY"
              }
            ],
            "params": [
              {
                "name": "website_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate free certificate for a website"
        },
        {
          "info": {
            "name": "Remove certificates from a website",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.10web.io/v1/hosting/websites/:website_id/certificate/remove",
            "headers": [
              {
                "name": "x-api-key",
                "value": "API_KEY"
              }
            ],
            "params": [
              {
                "name": "website_id",
                "value": "",
